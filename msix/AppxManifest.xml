<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store build. Identity values come from Partner Center
     (Product management > Product identity). Built by msix/build.ps1. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="DenysOsadchyi.SirenBar"
    Publisher="CN=14E8B307-4E3C-4A58-831A-C2CD7D7979D1"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SirenBar</DisplayName>
    <PublisherDisplayName>Denys Osadchyi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Повітряні тривоги України на панелі задач Windows 11</Description>
